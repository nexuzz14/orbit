# ==============================================================================
# Orbit Web - Environment Variables Template
# Salin berkas ini ke .env.local untuk pengembangan lokal.
# DILARANG MENYIMPAN SERVICE ROLE KEY ATAU RAHASIA LAIN DI SINI.
# ==============================================================================

# URL endpoint Supabase (wajib diisi oleh pengguna)
# Contoh lokal: http://127.0.0.1:54321
# Contoh produksi: https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anon (Public) Key (wajib diisi oleh pengguna)
# Nilai ini aman dipublikasikan ke client browser. RLS melindungi seluruh data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Domain aplikasi web (wajib diisi saat deploy ke Vercel / staging / prod)
# Contoh lokal: http://localhost:3000
# Contoh produksi: https://orbit.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
